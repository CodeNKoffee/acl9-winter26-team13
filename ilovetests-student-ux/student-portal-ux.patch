+/* Chunky pressable buttons and tiles: a solid bottom edge that the press sinks into. */
+.press { position: relative; transition: transform 150ms var(--ease), box-shadow 150ms var(--ease), background-color 150ms var(--ease); box-shadow: 0 4px 0 var(--edge, var(--color-rule-edge)); }
