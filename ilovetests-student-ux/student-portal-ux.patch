+  .press:active:not(:disabled) { transform: translateY(3px); box-shadow: 0 1px 0 var(--edge, var(--color-rule-edge)); }
+  .lift { transition: transform 180ms var(--ease), box-shadow 180ms var(--ease); }
+  .lift:hover { transform: translateY(-2px); box-shadow: 0 10px 24px -12px rgb(16 44 65 / .22); }
+}
+
+@keyframes rise { from { transform: translateY(8px); opacity: 0 } to { transform: none; opacity: 1 } }
+.rise { animation: rise .28s var(--ease, ease-out) both; }
+@keyframes sheet { from { transform: translateY(100%) } to { transform: none } }
+.sheet { animation: sheet .24s var(--ease, ease-out) both; }
+@keyframes fade { from { opacity: 0 } to { opacity: 1 } }
+.fade { animation: fade .2s ease-out both; }
+@keyframes ring { from { stroke-dashoffset: var(--full) } }
+.ring-draw { animation: ring .9s var(--ease, ease-out) .15s both; }
+@keyframes scanline { 0% { top: 4% } 50% { top: 92% } 100% { top: 4% } }
+.scanline { animation: scanline 1.6s ease-in-out infinite; }
+@keyframes flash { 0% { opacity: .9 } 100% { opacity: 0 } }
+.flash { animation: flash .35s ease-out both; }
+@keyframes burst { 0% { transform: translate(0,0) scale(.4); opacity: 0 } 25% { opacity: 1 } 100% { transform: translate(var(--x), var(--y)) scale(1); opacity: 0 } }
+.burst { animation: burst 1.1s var(--ease, ease-out) both; }
+@keyframes pulse-dot { 0%,100% { transform: scale(1); opacity: 1 } 50% { transform: scale(1.35); opacity: .55 } }
+.pulse-dot { animation: pulse-dot 1.6s ease-in-out infinite; }
+@media (prefers-reduced-motion: reduce) {
+  .press, .lift { transition: none; }
+  .rise, .sheet, .fade, .ring-draw, .scanline, .flash, .pulse-dot { animation: none; }
+  .burst { display: none; }
+}
